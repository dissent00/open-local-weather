__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/
.DS_Store
.env
*.local.yaml

# Dart / Flutter
.dart_tool/
# pubspec.lock is deliberately NOT committed: olw_core is a library package,
# and Dart's guidance is to commit the lock only for applications. The
# eventual Flutter app package should commit its own.
app/**/pubspec.lock

# Session handoff scratch — see the handoff skill
.claude/handoff.md

# Probe output — ROADMAP item 132. Written to the working directory by
# tools/probe_background_submit.py, carries interaction ids, and is a
# diagnostic artefact rather than part of the record.
probe_envelope_*.json
probe_background_*.json

# Rendered sandbox prompts — regenerable from `sweep.py --render-prompts` and
# ~210 KB a day across the fleet. The DATA they are rendered from is committed
# (sandbox/data/) because Open-Meteo's forecast endpoint only ever answers
# about now; a prompt is a pure function of that plus prompt.py, both of which
# are in the repo, so committing the renders would store a derivation.
sandbox/prompts/
