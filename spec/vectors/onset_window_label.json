{
  "vector_format_version": 1,
  "function": "onset_window_label",
  "description": "The onset tile's label: the spread of the wet models' onsets still ahead of the issuance, 'From HH:MM' when they agree, and nothing when none is ahead.",
  "cases": [
    {
      "name": "a spread",
      "input": {
        "onsets": [
          "16:00",
          "14:00",
          "19:00"
        ],
        "issued_hour": 6,
        "served_onset": "16:00"
      },
      "expected": "14:00 \u2013 19:00"
    },
    {
      "name": "agreement",
      "input": {
        "onsets": [
          "16:00",
          "16:00"
        ],
        "issued_hour": 6,
        "served_onset": "16:00"
      },
      "expected": "From 16:00"
    },
    {
      "name": "nothing to say",
      "input": {
        "onsets": [],
        "issued_hour": 6,
        "served_onset": null
      },
      "expected": null
    },
    {
      "name": "one behind the issuance",
      "input": {
        "onsets": [
          "14:00",
          "16:00"
        ],
        "issued_hour": 15,
        "served_onset": "14:00"
      },
      "expected": "From 16:00"
    },
    {
      "name": "all behind the issuance",
      "input": {
        "onsets": [
          "14:00"
        ],
        "issued_hour": 15,
        "served_onset": "14:00"
      },
      "expected": null
    },
    {
      "name": "no issuance hour",
      "input": {
        "onsets": [
          "09:00",
          "11:00"
        ],
        "issued_hour": null,
        "served_onset": "09:00"
      },
      "expected": "09:00 \u2013 11:00"
    },
    {
      "name": "a spread past six hours shows the served onset",
      "input": {
        "onsets": [
          "03:00",
          "14:00",
          "19:00"
        ],
        "issued_hour": 2,
        "served_onset": "14:00"
      },
      "expected": "From 14:00"
    },
    {
      "name": "the same spread with nothing served starts at the earliest",
      "input": {
        "onsets": [
          "03:00",
          "14:00",
          "19:00"
        ],
        "issued_hour": 2,
        "served_onset": null
      },
      "expected": "From 03:00"
    },
    {
      "name": "a spread of exactly six hours is still a window",
      "input": {
        "onsets": [
          "13:00",
          "19:00"
        ],
        "issued_hour": 6,
        "served_onset": "16:00"
      },
      "expected": "13:00 \u2013 19:00"
    }
  ]
}
