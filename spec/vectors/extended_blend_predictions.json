{
  "vector_format_version": 1,
  "function": "_extended_blend_predictions",
  "description": "Rain only. Everything else is absent rather than zero: a field the forecaster was not asked to commit to must not enter the record as a value it never gave.",
  "cases": [
    {
      "name": "Day+3 is selected out of a two-lead answer",
      "input": {
        "extended": [
          {
            "lead_time_days": 3,
            "rain": true,
            "rain_probability_pct": 70
          },
          {
            "lead_time_days": 7,
            "rain": false,
            "rain_probability_pct": 20
          }
        ],
        "lead_time_days": 3
      },
      "expected": [
        {
          "model": "olw_blend",
          "target_date": null,
          "rain": true,
          "onset": null,
          "precip_mm": null,
          "rain_probability_pct": 70,
          "wind_kmh": null,
          "high_c": null,
          "low_c": null,
          "cloud_cover_pct": null,
          "peak_cape_jkg": null,
          "wind_direction_deg": null,
          "mslp_trend": null
        }
      ]
    },
    {
