{
  "vector_format_version": 1,
  "function": "calls_in_window / prune",
  "description": "Rolling-window counting for the hard spend cap. The boundary is the sensitive part: an inclusive cutoff or a calendar day instead of a rolling window permits real extra spending while looking correct.",
  "cases": [
    {
      "name": "empty ledger",
      "input": {
        "now": "2026-08-21T12:00:00+00:00",
        "records": [],
        "window_hours": 24,
        "keep_days": 7
      },
      "expected": {
        "calls_in_window": 0,
        "kept_after_prune": []
      }
    },
    {
      "name": "all inside the window",
      "input": {
        "now": "2026-08-21T12:00:00+00:00",
        "records": [
          {
            "at": "2026-08-21T11:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          },
          {
            "at": "2026-08-20T13:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ],
        "window_hours": 24,
        "keep_days": 7
      },
      "expected": {
        "calls_in_window": 2,
        "kept_after_prune": [
          {
            "at": "2026-08-21T11:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          },
          {
            "at": "2026-08-20T13:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ]
      }
    },
    {
      "name": "exactly on the boundary is OUTSIDE \u2014 the cutoff is exclusive",
      "input": {
        "now": "2026-08-21T12:00:00+00:00",
        "records": [
          {
            "at": "2026-08-20T12:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ],
        "window_hours": 24,
        "keep_days": 7
      },
      "expected": {
        "calls_in_window": 0,
        "kept_after_prune": [
          {
            "at": "2026-08-20T12:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ]
      }
    },
    {
      "name": "one second inside the boundary counts",
      "input": {
        "now": "2026-08-21T12:00:00+00:00",
        "records": [
          {
            "at": "2026-08-20T12:00:01+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ],
        "window_hours": 24,
        "keep_days": 7
      },
      "expected": {
        "calls_in_window": 1,
        "kept_after_prune": [
          {
            "at": "2026-08-20T12:00:01+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ]
      }
    },
    {
      "name": "old calls do not count but are still retained for a week",
      "input": {
        "now": "2026-08-21T12:00:00+00:00",
        "records": [
          {
            "at": "2026-08-18T12:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          },
          {
            "at": "2026-08-21T10:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ],
        "window_hours": 24,
        "keep_days": 7
      },
      "expected": {
        "calls_in_window": 1,
        "kept_after_prune": [
          {
            "at": "2026-08-18T12:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          },
          {
            "at": "2026-08-21T10:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ]
      }
    },
    {
      "name": "far-old calls are pruned entirely",
      "input": {
        "now": "2026-08-21T12:00:00+00:00",
        "records": [
          {
            "at": "2026-07-22T12:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          },
          {
            "at": "2026-08-19T12:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ],
        "window_hours": 24,
        "keep_days": 7
      },
      "expected": {
        "calls_in_window": 0,
        "kept_after_prune": [
          {
            "at": "2026-08-19T12:00:00+00:00",
            "provider": "p",
            "model": "m",
            "purpose": "forecast"
          }
        ]
      }
    }
  ]
}
