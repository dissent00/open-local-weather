{
  "vector_format_version": 1,
  "function": "describe_day_rain",
  "description": "One phrase for a day's rain character: how much, when, and whether it thundered. Thunder outranks the amount \u2014 a day the airport observed a storm on is never described as dry, whatever the grid cell recorded.",
  "cases": [
    {
      "name": "no amount is a gap",
      "input": {
        "precip_mm": null,
        "onset": null,
        "thunder": null,
        "issued_hour": null
      },
      "expected": null
    },
    {
      "name": "plain dry day",
      "input": {
        "precip_mm": 0.0,
        "onset": null,
        "thunder": null,
        "issued_hour": null
      },
      "expected": "dry"
    },
    {
      "name": "dry with thunder is never dry",
      "input": {
        "precip_mm": 0.5,
        "onset": null,
        "thunder": true,
        "issued_hour": null
      },
      "expected": "dry but thundery"
    },
    {
      "name": "thunder false still reads dry",
      "input": {
        "precip_mm": 0.5,
        "onset": null,
        "thunder": false,
        "issued_hour": null
      },
      "expected": "dry"
    },
    {
      "name": "thunder unobserved still reads dry",
      "input": {
        "precip_mm": 0.5,
        "onset": null,
        "thunder": null,
        "issued_hour": null
      },
      "expected": "dry"
    },
    {
      "name": "dry band with an evening shower",
      "input": {
        "precip_mm": 0.9,
        "onset": "17:00",
        "thunder": null,
        "issued_hour": null
      },
      "expected": "dry apart from a brief evening shower"
    },
    {
      "name": "dry band with an afternoon shower",
      "input": {
        "precip_mm": 0.9,
        "onset": "13:00",
