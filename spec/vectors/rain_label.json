      },
      "expected": "Isolated Evening Showers & Thunderstorms"
    },
    {
      "name": "wet 20.0 mm calm Morning",
      "input": {
        "rain": true,
        "precip_mm": 20.0,
        "convective": false,
        "when": "Morning"
      },
      "expected": "Morning Rain"
    },
    {
