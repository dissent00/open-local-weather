{
  "vector_format_version": 1,
  "function": "rain_label",
  "description": "The rain tile's label from the call: the band under 5 mm reads isolated, 15 mm and over reads rain, thunder names the storms, and the onset's word says when.",
  "cases": [
    {
      "name": "dry 0.0 mm calm no word",
      "input": {
        "rain": false,
        "precip_mm": 0.0,
        "convective": false,
        "when": null
      },
      "expected": "Dry / No Rain"
    },
    {
      "name": "dry 0.0 mm convective Evening",
      "input": {
        "rain": false,
        "precip_mm": 0.0,
        "convective": true,
        "when": "Evening"
      },
      "expected": "Dry / Evening Thunder Possible"
    },
    {
      "name": "dry 0.0 mm convective no word",
