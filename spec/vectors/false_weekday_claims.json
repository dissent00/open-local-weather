{
  "vector_format_version": 1,
  "function": "false_weekday_claims",
  "description": "Weekday/date pairings a narrative asserts that the calendar contradicts. Recorded against the entry and published anyway. A false alarm is worse than the defect, so the correct and the unresolvable cases matter as much as the wrong ones.",
  "cases": [
    {
      "name": "the case that prompted it",
      "input": {
        "today": "2026-09-13",
        "text": "Monday (16 September) is expected to see scattered rainfall."
      },
      "expected": [
        {
          "kind": "weekday_date_mismatch",
          "quote": "Monday (16 September",
          "detail": "2026-09-16 is a Wednesday, not a Monday"
        }
      ]
    },
    {
      "name": "published 2026-08-11",
      "input": {
        "today": "2026-08-11",
        "text": "Rain clears by Sunday, August 17 and returns Monday, August 18."
      },
      "expected": [
        {
          "kind": "weekday_date_mismatch",
          "quote": "Sunday, August 17",
          "detail": "2026-08-17 is a Monday, not a Sunday"
        },
        {
          "kind": "weekday_date_mismatch",
          "quote": "Monday, August 18",
          "detail": "2026-08-18 is a Tuesday, not a Monday"
        }
      ]
    },
    {
      "name": "ordinal suffix",
      "input": {
        "today": "2026-08-13",
        "text": "A drier spell arrives Sunday, August 17th."
      },
      "expected": [
        {
          "kind": "weekday_date_mismatch",
          "quote": "Sunday, August 17th",
          "detail": "2026-08-17 is a Monday, not a Sunday"
        }
      ]
    },
    {
      "name": "correct, day first",
      "input": {
        "today": "2026-09-13",
        "text": "Wednesday (16 September) stays dry."
      },
      "expected": []
    },
    {
      "name": "correct, month first",
      "input": {
        "today": "2026-09-13",
        "text": "Expect showers Monday, September 14."
      },
      "expected": []
    },
    {
      "name": "correct, ISO",
      "input": {
        "today": "2026-09-13",
        "text": "Rain on Monday, 2026-09-14."
      },
      "expected": []
    },
    {
      "name": "crosses into next year",
      "input": {
        "today": "2026-12-29",
        "text": "Rain returns Saturday, 2 January."
      },
      "expected": []
    },
    {
      "name": "crosses from last year",
      "input": {
        "today": "2027-01-02",
        "text": "Drier than Tuesday, 29 December."
      },
      "expected": []
    },
    {
      "name": "weekday alone",
      "input": {
        "today": "2026-09-13",
        "text": "Rain becomes likely by Wednesday."
      },
      "expected": []
    },
    {
      "name": "date alone",
      "input": {
        "today": "2026-09-13",
        "text": "Totals reach 23 mm by 20 September."
      },
      "expected": []
    },
    {
      "name": "impossible date",
      "input": {
        "today": "2026-02-25",
        "text": "Snow on Sunday, 29 February."
      },
      "expected": []
    },
    {
      "name": "nothing at all",
      "input": {
        "today": "2026-09-13",
        "text": "A quiet day with light winds."
