{
  "vector_format_version": 1,
  "function": "low_divergence",
  "description": "ROADMAP item 143. How far the station's overnight low sits from the standing call, measured on every run that can make the comparison and stored whether or not it is worth printing. `delta_c` is OBSERVED MINUS FORECAST, so positive means the station came in WARMER than the call. `notable` is worth a reader's footnote; `decisive` is worth an LLM call, and is `notable` AND near freezing -- two degrees is nothing at 20C and is the difference between ice and no ice at 2C. A reading ABOVE the call requires the night to be over (`low_is_settled` true, never null); one BELOW it settles at any hour, because a minimum only falls.",
  "cases": [
    {
      "name": "the founding case: 20.0 observed against a call of 18.2",
      "input": {
        "standing": {
          "temp_low_c": 18.2
        },
        "observed": {
          "low_c": 20.0
        },
        "low_is_settled": true
      },
      "expected": {
        "forecast_c": 18.2,
        "observed_c": 20.0,
        "delta_c": 1.8,
        "margin_c": 3.0,
        "notable": false,
        "decisive": false
      }
    },
    {
      "name": "the same gap, before sunrise, is not yet a comparison",
