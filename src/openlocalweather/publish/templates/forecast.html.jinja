<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ location.primary_place_name }} Weather — {{ entry.date.isoformat() }}</title>
<meta name="description" content="{{ entry.rain_expected }}. High {{ entry.temp_high_low_display }}.">
<link rel="stylesheet" href="{{ nav.css }}">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ nav.home }}">{{ location.primary_place_name }} Weather</a>
    <nav>
      <a href="{{ nav.home }}">Today</a>
      <a href="{{ nav.archive }}">Archive</a>
      <a href="{{ nav.accuracy }}">Accuracy</a>
    </nav>
  </div>
</header>
<main class="wrap">
  <p class="disclaimer-banner">Experimental, AI-assisted forecast &mdash; not an official government product. Do not rely on this for life-safety decisions.{% if location.local_bulletin_source_name %} For official warnings and advisories, consult {% if location.local_bulletin_url %}<a href="{{ location.local_bulletin_url }}">{{ location.local_bulletin_source_name }}</a>{% else %}{{ location.local_bulletin_source_name }}{% endif %}.{% endif %}</p>

  {# ROADMAP item 53.4. A run that lost a block used to look exactly like a
     run that did not, everywhere a reader could see. Worded as a gap and
     nothing more: it says what was missing and stops, because the failure
     this whole item comes from was a run reasoning onward from an absence
     and publishing the conclusion as reassurance. #}
  {% if entry.meta.degradations %}
  <div class="banner run-degraded">
    <p><strong>This forecast was built on less than usual.</strong></p>
    <ul>
      {% for d in entry.meta.degradations %}<li>{{ d.summary }}</li>{% endfor %}
    </ul>
    <p class="summary">The technical detail is in <a href="#run-notes">Notes on this forecast</a>, at the end.</p>
  </div>
  {% endif %}

  {% if not is_latest %}
  <p class="banner">This is an archived forecast for {{ entry.date.isoformat() }}. <a href="{{ nav.home }}">See today's forecast</a>.</p>
  {% endif %}

  <h1>{{ location.primary_place_name }}</h1>
  <p class="meta">Forecast for {{ entry.date.isoformat() }} &middot; multi-model synthesis via {{ entry.meta.llm_model }}{% if issuance_label %} &middot; {{ issuance_label }}{% endif %}</p>

  {# Deliberately a SINGLE forecast per page — no stacking of morning and
     evening content together. That was tried and reverted: it buried
     whichever issuance was current below the other one, forcing a scroll
     past stale content to reach the thing most readers actually want.
     Each issuance gets its own URL instead — see publish/pages.py's
     GitHubPagesPublisher.publish() and IssuanceSnapshot's doc
     comment (models.py) for the full history of why. #}
  <div class="stat-grid">
    <div class="stat"><span class="label">High / Low</span><span class="value">{{ entry.temp_high_low_display }}</span></div>
    <div class="stat"><span class="label">Rain</span><span class="value">{{ entry.rain_expected }}</span></div>
    {% if entry.onset_window %}
    <div class="stat"><span class="label">Onset Window</span><span class="value">{{ entry.onset_window }}</span></div>
    {% endif %}
    {% if entry.uv_index_max %}
    <div class="stat"><span class="label">UV Index</span><span class="value">{{ entry.uv_index_max }}</span></div>
    {% endif %}
    {% if entry.air_quality_aqi %}
    <div class="stat"><span class="label">Air Quality</span><span class="value">{{ entry.air_quality_aqi }}</span></div>
    {% endif %}
    {# Computed in code from the day's astronomical data, never written by the
       model. Both are shown only when both exist: in polar night there is no
       sunrise to report, and half a pair reads as a rendering fault rather
       than as the honest answer it is. #}
    {% if entry.sunrise and entry.sunset %}
    <div class="stat"><span class="label">Sunrise</span><span class="value">{{ entry.sunrise }}</span></div>
    <div class="stat"><span class="label">Sunset</span><span class="value">{{ entry.sunset }}</span></div>
    {% endif %}
  </div>

  {{ narrative_html | safe }}

  {# The technical half of the degradation notice. Kept away from the banner
     at the top deliberately: that is where somebody decides whether to go
     outside, and "the forward hourly window did not arrive" tells that person
     nothing they can act on. Here it is worth having, because this is where a
     reader who wants to know WHY comes looking. #}
  {% if entry.meta.degradations %}
  <h2 id="run-notes">Notes on this forecast</h2>
  <ul class="archive-list">
    {% for d in entry.meta.degradations %}
    <li><strong>{{ d.summary }}</strong><span class="summary">{{ d.detail }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if entry.ground_aqi %}
  <h2>Ground AQI Stations</h2>
  {% if ground_aqi_summary %}
  <p class="meta">Range across {{ ground_aqi_summary.stations_with_aqi }} currently-fresh reporting station{{ "s" if ground_aqi_summary.stations_with_aqi != 1 }}: AQI {{ ground_aqi_summary.aqi_min }}&ndash;{{ ground_aqi_summary.aqi_max }}, highest at <strong>{{ ground_aqi_summary.highest_station_name }}</strong>.{% if ground_aqi_summary.stations_stale %} ({{ ground_aqi_summary.stations_stale }} station{{ "s" if ground_aqi_summary.stations_stale != 1 }} excluded as stale.){% endif %}</p>
  {% else %}
  <p class="meta">No station has a sufficiently current composite AQI reading right now — see individual readings below.</p>
  {% endif %}
  <ul class="archive-list">
    {% for station, age_hours, stale in ground_aqi_stations %}
    <li>
      <strong>{{ station.name }}</strong>
      {% if station.aqi is not none %}&mdash; AQI {{ station.aqi }}{% else %}&mdash; AQI unavailable{% endif %}
      {% if station.pm25 is not none %}<span class="summary">PM2.5 {{ station.pm25 }}</span>{% endif %}
      {% if station.pm10 is not none %}<span class="summary">PM10 {{ station.pm10 }}</span>{% endif %}
      {% if age_hours is not none %}
      <span class="summary">{% if stale %}stale &mdash; {% endif %}measured {{ "%.1f"|format(age_hours) }}h ago</span>
      {% else %}
      <span class="summary">measurement time unknown</span>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p>Open-source, location-agnostic, multi-model synoptic forecasting for {{ location.region_name }} — genuine model synthesis with a self-improving accuracy loop, not a relayed single-source number.
    <a href="{{ nav.github }}">View source on GitHub</a>.</p>
  </div>
</footer>
</body>
</html>
