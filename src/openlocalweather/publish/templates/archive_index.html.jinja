<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ location.primary_place_name }} Weather — Archive</title>
<link rel="stylesheet" href="{{ nav.css }}">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ nav.home }}">{{ location.primary_place_name }} Weather</a>
    <nav>
      <a href="{{ nav.home }}">Today</a>
      <a href="{{ nav.archive }}">Archive</a>
      <a href="{{ nav.accuracy }}">Accuracy</a>
    </nav>
  </div>
</header>
<main class="wrap">
  <p class="disclaimer-banner">Experimental, AI-assisted forecast &mdash; not an official government product. Do not rely on this for life-safety decisions.{% if location.local_bulletin_source_name %} For official warnings and advisories, consult {% if location.local_bulletin_url %}<a href="{{ location.local_bulletin_url }}">{{ location.local_bulletin_source_name }}</a>{% else %}{{ location.local_bulletin_source_name }}{% endif %}.{% endif %}</p>

  <h1>Forecast Archive</h1>
  <p class="meta">Every daily forecast ever published for {{ location.primary_place_name }} — the full, git-versioned record. Every prediction here was independently scored against what actually happened; see each day's "Forecaster Confidence Notes" section for how that history shaped that day's call.</p>

  {% if items %}
  <ul class="archive-list">
    {% for item in items %}
    <li><a href="{{ item.slug }}.html">{{ item.date.isoformat() }}{% if item.label %} &mdash; {{ item.label }}{% endif %}</a></li>
    {% endfor %}
  </ul>
  {% else %}
  <p>No forecasts published yet.</p>
  {% endif %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p><a href="{{ nav.github }}">View source on GitHub</a>.</p>
  </div>
</footer>
</body>
</html>
