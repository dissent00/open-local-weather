<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ location.primary_place_name }} Weather — Archive</title>
<link rel="stylesheet" href="{{ nav.css }}">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ nav.home }}">{{ location.primary_place_name }} Weather</a>
    <nav>
      <a href="{{ nav.home }}">Today</a>
      <a href="{{ nav.archive }}">Archive</a>
      <a href="{{ nav.subscribe }}">Subscribe</a>
    </nav>
  </div>
</header>
<main class="wrap">
  <h1>Forecast Archive</h1>
  <p class="meta">Every daily forecast ever published for {{ location.primary_place_name }} — the full, git-versioned record. Every prediction here was independently scored against what actually happened; see each day's "Forecaster Confidence Notes" section for how that history shaped that day's call.</p>

  {% if dates %}
  <ul class="archive-list">
    {% for d in dates %}
    <li><a href="{{ d.isoformat() }}.html">{{ d.isoformat() }}</a></li>
    {% endfor %}
  </ul>
  {% else %}
  <p>No forecasts published yet.</p>
  {% endif %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p><a href="{{ nav.github }}">View source on GitHub</a>.</p>
  </div>
</footer>
</body>
</html>
